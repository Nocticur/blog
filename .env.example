# ─────────────────────────────────────────────────────────────
# 本项目配置推荐全部使用「系统环境变量」，不使用 .env 文件：
#   Windows：系统属性 → 高级 → 环境变量（或 PowerShell 的
#   [Environment]::SetEnvironmentVariable("名字","值","User")），
#   设置后需重开终端 / 重启 dev server 才生效。
#   Vercel：项目 Settings → Environment Variables。
# 下面的变量仅作为备选：确有需要时复制本文件为 .env 填写
# （.env 已被 gitignore），系统环境变量优先级始终高于 .env。
# ─────────────────────────────────────────────────────────────

# ── IndexNow（可选） ────────────────────────────────
# 用于主动推送 URL 给 Bing/Yandex/Seznam/Naver 等搜索引擎
# 密钥需与 public/{key}.txt 文件名一致，文件内容为该密钥本身
# 生成命令：node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
INDEXNOW_KEY=your_indexnow_key_here

# ── 写作空间（/writing/）密码（可选） ───────────────
# 不设置时使用内置默认密码。二选一，明文优先：
#   WRITING_PASSWORD       明文密码，代码内现算 SHA-256（推荐）
#   WRITING_PASSWORD_HASH  预先算好的 SHA-256 哈希
# 线上：在 Vercel 项目 Settings → Environment Variables 添加同名变量
# 后重新部署，保持与本地一致
# WRITING_PASSWORD=
# WRITING_PASSWORD_HASH=

# ── 写作空间 GitHub 上传（可选） ─────────────────────
# 编辑器「上传 GitHub」按钮把文章提交到仓库触发 Vercel 自动部署。
# 仅本地 dev server（astro dev）使用，token 不会进入前端或打包产物。
# GITHUB_TOKEN           GitHub fine-grained PAT，需目标仓库 Contents 读写权限
#                        （回退读取 GH_TOKEN）。生成：GitHub → Settings →
#                        Developer settings → Fine-grained tokens
# WRITING_GITHUB_REPO    可选，「上传仓库」输入框默认值（owner/repo）；不设时
#                        自动从 git remote origin 推导（如 Nocticur/blog）
# WRITING_GITHUB_BRANCH  可选，提交的目标分支，缺省用仓库默认分支
# GITHUB_TOKEN=
# WRITING_GITHUB_REPO=
# WRITING_GITHUB_BRANCH=
