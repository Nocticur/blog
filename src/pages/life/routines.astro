---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config";
if (!siteConfig.pages.routines) return Astro.redirect("/404/");
const routines = (await getCollection("life")).filter((entry) => entry.id.startsWith("routines/") && !entry.data.draft).sort((a,b) => (a.data.time || "").localeCompare(b.data.time || ""));
---
<MainGridLayout title="日常规划" description="记录和规划生活中的各项事务">
  <div class="card-base p-6 md:p-9"><header class="mb-8"><p class="text-xs uppercase tracking-[0.25em] text-[var(--primary)]">Routines</p><h1 class="text-3xl font-semibold mt-2">日常规划</h1></header>{routines.length ? <div class="grid gap-4 md:grid-cols-2">{routines.map((entry) => <article class="rounded-2xl border border-black/8 p-5 dark:border-white/10"><div class="flex items-center gap-3"><span class="text-2xl">{entry.data.icon || "◷"}</span><h2 class="text-xl font-medium">{entry.data.title || entry.data.name || entry.id}</h2></div>{entry.data.time && <p class="mt-2 text-sm text-[var(--primary)]">{entry.data.time}</p>}<p class="mt-3 text-sm leading-7 text-neutral-600 dark:text-neutral-300">{entry.data.description}</p><span class="mt-4 inline-block rounded-full bg-black/5 px-3 py-1 text-xs dark:bg-white/10">{entry.data.status === "done" ? "已完成" : entry.data.status === "active" ? "进行中" : "待完成"}</span></article>)}</div> : <div class="rounded-2xl border border-dashed border-black/15 p-12 text-center text-sm text-neutral-500">还没有规划记录。</div>}</div>
</MainGridLayout>
