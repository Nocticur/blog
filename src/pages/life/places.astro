---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getCollection } from "astro:content";
import { siteConfig } from "@/config";
import { normalizePlace } from "@/utils/feature-data";
if (!siteConfig.pages.places) return Astro.redirect("/404/");
const places = (await getCollection("life")).filter((entry) => entry.id.startsWith("places/") && !entry.data.draft).map((entry) => ({ entry, place: normalizePlace(entry.data) }));
---
<MainGridLayout title="去过的地方" description="足迹地图与旅行记录">
  <div class="card-base p-6 md:p-9"><header class="mb-8"><p class="text-xs uppercase tracking-[0.25em] text-[var(--primary)]">Places</p><h1 class="text-3xl font-semibold mt-2">足迹地图</h1></header><div class="rounded-2xl border border-black/8 bg-[linear-gradient(135deg,rgba(100,116,139,.12),transparent)] p-5 dark:border-white/10"><div class="grid min-h-48 place-items-center rounded-xl border border-dashed border-black/15 text-center text-sm text-neutral-500 dark:border-white/15">离线足迹视图<br /><span class="text-xs">地图数据随站点构建，无需外部密钥</span></div></div>{places.length ? <div class="mt-6 grid gap-4 md:grid-cols-2">{places.map(({entry, place}) => <article class="rounded-2xl border border-black/8 p-5 dark:border-white/10"><h2 class="text-xl font-medium">{place.name}</h2><p class="mt-2 text-sm leading-7 text-neutral-600 dark:text-neutral-300">{place.description || entry.data.description}</p>{place.lat !== null && place.lng !== null && <p class="mt-3 text-xs text-neutral-500">{place.lat.toFixed(4)}, {place.lng.toFixed(4)}</p>}</article>)}</div> : <div class="mt-6 rounded-2xl border border-dashed border-black/15 p-12 text-center text-sm text-neutral-500">还没有足迹记录。</div>}</div>
</MainGridLayout>
