---
import { getCollection, render } from "astro:content";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import PlacesMap from "@/components/pages/PlacesMap.svelte";
import { siteConfig } from "@/config";
import { normalizePlace } from "@/utils/feature-data";

if (!siteConfig.pages.places) return Astro.redirect("/404/");
const places = await Promise.all(
	(await getCollection("life"))
		.filter((entry) => entry.id.startsWith("places/") && !entry.data.draft)
		.map(async (entry) => ({
			entry,
			place: normalizePlace(entry.data),
			Content: (await render(entry)).Content,
		})),
);
---
<MainGridLayout title="去过的地方" description="足迹地图与旅行记录">
 <div class="card-base p-6 md:p-9">
 <h1 class="text-3xl font-semibold mb-6">足迹地图</h1>
 <PlacesMap client:load places={places.map(({place},index)=>({...place,id:`place-${index}`}))}/>
 {places.length ? <div class="mt-6 grid gap-4 md:grid-cols-2">{places.map(({entry,place,Content},index)=>
 <article id={`place-${index}`} class="rounded-xl border border-neutral-500/20 p-5 scroll-mt-24">
 <h2 class="text-xl font-medium">{place.name}</h2>
 {entry.data.date && <time class="text-sm opacity-60">{entry.data.date.toISOString().slice(0,10)}</time>}
 <p class="my-3 text-sm">{place.description || entry.data.description}</p>
 <div class="prose prose-sm dark:prose-invert"><Content/></div>
 {place.lat!==null && place.lng!==null && <p class="text-xs opacity-60 my-3">{place.lat.toFixed(4)}, {place.lng.toFixed(4)}</p>}
 <div class="grid grid-cols-2 gap-2">{place.photos.map(photo=><a href={photo} data-fancybox={entry.id}><img src={photo} alt={place.name} loading="lazy" class="rounded-lg w-full aspect-square object-cover"/></a>)}</div>
 </article>)}</div> : <p class="py-10 text-center text-sm text-neutral-500">还没有足迹记录。</p>}
 </div>
</MainGridLayout>
