---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import FilteredList from "@/components/features/FilteredList.astro";
import { pengyouConfig, siteConfig } from "@/config";
import { fetchCircle } from "@/utils/feed-fetch";

if (!siteConfig.pages.pengyou || !pengyouConfig.enabled)
	return Astro.redirect("/404/");
const feeds = pengyouConfig.feeds.filter(
	(feed) => feed.enabled !== false && feed.url,
);
const items = await fetchCircle(feeds);
const updatedAt = new Date().toLocaleString("zh-CN", {
	timeZone: "Asia/Shanghai",
});
---
<MainGridLayout title="朋友圈" description="看看朋友们最近分享了什么">
  <div class="card-base p-6 md:p-9"><header class="mb-8"><p class="text-xs uppercase tracking-[0.25em] text-[var(--primary)]">Circle</p><h1 class="text-3xl font-semibold mt-2">朋友圈</h1><p class="mt-2 text-sm text-neutral-500">订阅更新于 {updatedAt}</p></header><FilteredList label="作者" pageSize={pengyouConfig.pageSize}>{items.length ? <div class="grid gap-4 md:grid-cols-2">{items.map((item) => <a data-filter-item data-tags={JSON.stringify([item.author])} class="block rounded-2xl border border-black/8 p-5 transition hover:border-[var(--primary)] dark:border-white/10" href={item.link} target="_blank" rel="noopener noreferrer"><div class="flex items-center justify-between gap-3"><span class="font-medium">{item.author}</span><time class="text-xs text-neutral-500">{item.date}</time></div><h2 class="mt-3 text-lg">{item.title}</h2>{item.description && <p class="mt-2 line-clamp-3 text-sm leading-6 text-neutral-500">{item.description}</p>}</a>)}</div> : <div class="rounded-2xl border border-dashed border-black/15 p-12 text-center text-sm text-neutral-500">暂时没有可展示的订阅文章。</div>}</FilteredList></div>
</MainGridLayout>
