---
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig, pengyouConfig } from "@/config";
import { parseFeedItems } from "@/utils/feature-data";
if (!siteConfig.pages.pengyou) return Astro.redirect("/404/");
const feeds = pengyouConfig.feeds.filter((feed) => feed.enabled !== false && feed.url);
const results = await Promise.all(feeds.map(async (feed) => { try { const controller = new AbortController(); const timeout = setTimeout(() => controller.abort(), 5000); const response = await fetch(feed.url, { signal: controller.signal }); clearTimeout(timeout); if (!response.ok) return []; return parseFeedItems(await response.text()).map((item) => ({ ...item, author: feed.name, avatar: feed.avatar })); } catch { return []; } }));
const items = results.flat().sort((a, b) => b.date.localeCompare(a.date)).slice(0, pengyouConfig.pageSize);
---
<MainGridLayout title="朋友圈" description="看看朋友们最近分享了什么">
  <div class="card-base p-6 md:p-9"><header class="mb-8"><p class="text-xs uppercase tracking-[0.25em] text-[var(--primary)]">Circle</p><h1 class="text-3xl font-semibold mt-2">朋友圈</h1><p class="mt-2 text-sm text-neutral-500">构建时读取公开 RSS／Atom，不保存外部站点内容。</p></header>{items.length ? <div class="grid gap-4 md:grid-cols-2">{items.map((item) => <a class="block rounded-2xl border border-black/8 p-5 transition hover:border-[var(--primary)] dark:border-white/10" href={item.link} target="_blank" rel="noopener noreferrer"><div class="flex items-center justify-between gap-3"><span class="font-medium">{item.author}</span><time class="text-xs text-neutral-500">{item.date}</time></div><h2 class="mt-3 text-lg">{item.title}</h2>{item.description && <p class="mt-2 line-clamp-3 text-sm leading-6 text-neutral-500">{item.description}</p>}</a>)}</div> : <div class="rounded-2xl border border-dashed border-black/15 p-12 text-center text-sm text-neutral-500">暂未配置 RSS 源，编辑 src/config/pengyouConfig.ts 后重新构建即可。</div>}</div>
</MainGridLayout>
