---
import WritingStudio from "@components/pages/WritingStudio.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.writing) {
    return Astro.redirect("/404/");
}

const title = i18n(I18nKey.writing);
---

<MainGridLayout title={title} description={title} hasOwnH1={true} robots="noindex,follow" sidebarPosition="none">
    <div class="min-h-[80vh]">
        <!-- 密码校验/仓库等信息全部由 /api/writing/auth 服务端返回，页面不携带任何写作配置 -->
        <WritingStudio client:load />
    </div>
</MainGridLayout>
