---
import WritingStudio from "@components/pages/WritingStudio.svelte";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";
import { writingConfig } from "@/config/writingConfig";
import { url } from "@/utils/url-utils";

if (!siteConfig.pages.writing) {
	return Astro.redirect("/404/");
}

const title = i18n(I18nKey.writing);
---

<MainGridLayout title={title} description={title} hasOwnH1={true} robots="noindex,follow" sidebarPosition="none">
    <div class="min-h-[80vh]">
        <WritingStudio
            client:load
            passwordHash={writingConfig.passwordHash}
            defaultRepo={writingConfig.defaultRepo}
            githubTokenReady={writingConfig.githubTokenReady}
        />
    </div>
</MainGridLayout>
