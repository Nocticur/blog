---
import MailApp from "@components/features/MailApp.svelte";
import MailAppFallback from "@components/features/MailAppFallback.astro";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import "@/styles/pages/mail.css";

const title = i18n(I18nKey.email);
const description =
	"博客内置邮箱登录与收件：注册或登录专属邮箱地址，在线阅读、刷新和删除邮件。";
---

<MainGridLayout
	title={title}
	description={description}
	hasOwnH1={true}
	sidebarPosition="none"
>
	<h1 class="sr-only">{title}</h1>
	<div class="mail-page">
		<div class="mail-admin-entry"><a href="/mail/admin/">管理员入口</a></div>
		<MailApp client:only="svelte">
			<MailAppFallback slot="fallback" />
		</MailApp>
	</div>
</MainGridLayout>
